---
import { sections } from '../scripts/sections';
import { withBase } from '../scripts/paths';


const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href.replace(/\/$/, ''));
---

<div class="nav-wrapper" transition:persist="main-nav">
	<nav class="navbar" aria-label="Main navigation">
		<a href={withBase('/')} class="navbar-brand">
			<div class="nav-avatar" aria-hidden="true"><span class="header-font">SG</span></div>
			<span class="brand-text">
				<span class="nav-name">Salvatore Galeotta</span>
				<span class="nav-role header-font">.NET backend &amp; game developer</span>
			</span>
		</a>

		<ul class="navbar-nav">
			{
				sections.map((tab) => (
					<li class="nav-item" style={`--tab-accent: ${tab.accent}`}>
						<a
							href={tab.href}
							class:list={['nav-link', { active: isActive(tab.href) }]}
							data-accent={tab.accent}
							aria-current={isActive(tab.href) ? 'page' : undefined}
						>
							<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon} />
							<span>{tab.label}</span>
						</a>
					</li>
				))
			}
		</ul>

		<button class="mobile-toggle" aria-label="Open menu" aria-expanded="false">
			<span class="hamburger" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
		</button>
	</nav>

	<div class="mobile-menu-overlay" aria-hidden="true"></div>

	<div class="mobile-menu">
		<div class="mobile-menu-inner">
			<ul class="mobile-menu-nav">
				{
					sections.map((tab) => (
						<li class="mobile-menu-item" style={`--tab-accent: ${tab.accent}`}>
							<a
								href={tab.href}
								class:list={['mobile-menu-link', { active: isActive(tab.href) }]}
								data-accent={tab.accent}
								aria-current={isActive(tab.href) ? 'page' : undefined}
							>
								<svg class="mobile-menu-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={tab.icon} />
								<span>{tab.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</div>

<style>
	.nav-wrapper {
		position: sticky;
		top: 0;
		z-index: 20;
	}

	.navbar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		width: 100%;
		padding: 14px clamp(10px, 1.5vw, 20px);
		background: color-mix(in srgb, var(--tab-color) 88%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		transition: box-shadow 0.4s ease;
	}

	.navbar:has(.nav-link.active) {
		box-shadow: 0 8px 30px -6px color-mix(in srgb, var(--active-color, transparent) 45%, transparent);
	}

	/* ==================== BRAND ==================== */
	.navbar-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		z-index: 2;
		position: relative;
		flex-shrink: 0;
		min-width: 0;
	}

	.nav-avatar {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		flex-shrink: 0;
		background: linear-gradient(135deg, var(--accent-green), var(--accent-blue));
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
	}

	.nav-avatar span {
		font-weight: 700;
		font-size: 0.78rem;
		color: var(--tab-color-solid);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.nav-name {
		font-family: monospace;
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--accent-blue) 85%, var(--text-color));
	}

	.nav-role {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-color);
	}

	/* ==================== NAV LINKS ==================== */
	.navbar-nav {
		display: flex;
		align-items: center;
		gap: 26px;
		list-style: none;
		margin: 0;
		padding: 0;
		z-index: 2;
		position: relative;
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 9px 16px;
		text-decoration: none;
		color: var(--text-color);
		opacity: 0.62;
		font-weight: 500;
		font-size: 0.92rem;
		white-space: nowrap;
		border-radius: 20px;
		transition: opacity 0.3s ease, color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease,
			transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.nav-link:hover {
		opacity: 1;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
		transform: translateY(-2px);
	}

	.nav-link.active {
		opacity: 1;
		color: var(--tab-accent);
		background: color-mix(in srgb, var(--tab-accent) 12%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--tab-accent) 30%, transparent),
			0 4px 12px color-mix(in srgb, var(--tab-accent) 25%, transparent);
	}

	.nav-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.3s ease;
	}

	.nav-link:hover .nav-icon {
		transform: scale(1.1);
	}

	/* ==================== MOBILE TOGGLE ==================== */
	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 4px;
		width: 34px;
		height: 34px;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		cursor: pointer;
		padding: 6px;
		border-radius: 50%;
		transition: background 0.3s ease;
		z-index: 2;
		position: relative;
		flex-shrink: 0;
		margin-left: auto;
	}

	.mobile-toggle:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.hamburger {
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 20px;
		height: 16px;
		justify-content: center;
	}

	.hamburger span {
		width: 20px;
		height: 2px;
		background: var(--text-color);
		border-radius: 2px;
		transition: all 0.25s ease;
		display: block;
	}

	.mobile-toggle.active .hamburger span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.mobile-toggle.active .hamburger span:nth-child(2) {
		opacity: 0;
	}

	.mobile-toggle.active .hamburger span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* ==================== MOBILE MENU ==================== */
	.mobile-menu-overlay {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		height: 100vh;
		height: 100dvh;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		z-index: 1500;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;
		pointer-events: none;
	}

	.mobile-menu-overlay.active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.mobile-menu {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		z-index: 1600;
		display: grid;
		grid-template-rows: 0fr;
		visibility: hidden;
		background: linear-gradient(180deg, var(--tab-color) 0%, var(--bg) 100%);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		transition: grid-template-rows 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.4s;
	}

	.mobile-menu.active {
		grid-template-rows: 1fr;
		visibility: visible;
	}

	.mobile-menu-inner {
		overflow: hidden;
		min-height: 0;
	}

	.mobile-menu-nav {
		padding: 20px 20px 24px;
		list-style: none;
		margin: 0;
	}

	.mobile-menu-link {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px 18px;
		text-decoration: none;
		color: var(--text-color);
		opacity: 0.85;
		font-weight: 500;
		font-size: 1.05rem;
		border-radius: 14px;
		transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		margin-bottom: 10px;
	}

	.mobile-menu-link:hover {
		background: rgba(255, 255, 255, 0.1);
		opacity: 1;
	}

	.mobile-menu-link.active {
		opacity: 1;
		color: var(--tab-accent);
		background: color-mix(in srgb, var(--tab-accent) 14%, transparent);
		border-color: color-mix(in srgb, var(--tab-accent) 35%, transparent);
	}

	.mobile-menu-icon {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex-shrink: 0;
	}

	/* ==================== RESPONSIVE ==================== */
	/* The big brand↔links gap only makes sense when the links are actually
	   showing — on mobile .navbar-nav is hidden, so this would otherwise
	   land between the logo and the hamburger button and overflow the
	   screen. */
	@media (min-width: 1001px) {
		.navbar-brand {
			margin-right: 120px;
		}
	}

	@media (max-width: 1000px) {
		.navbar-nav {
			display: none;
		}

		.mobile-toggle {
			display: flex;
		}
	}

	/* Only drop the name/role text on genuinely tight phone widths, where it
	   would otherwise crowd the avatar + hamburger button. */
	@media (max-width: 420px) {
		.brand-text {
			display: none;
		}
	}
</style>

<script>
	import { navigate } from 'astro:transitions/client';

	const homeUrl = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
	const stripSlash = (path: string) => path.replace(/\/$/, '');

	function setMenuOpen(open: boolean) {
		document.querySelector('.mobile-toggle')?.classList.toggle('active', open);
		document.querySelector('.mobile-toggle')?.setAttribute('aria-expanded', String(open));
		document.querySelector('.mobile-menu')?.classList.toggle('active', open);
		document.querySelector('.mobile-menu-overlay')?.classList.toggle('active', open);
		document.body.style.overflow = open ? 'hidden' : '';
	}

	// Capture phase: must run (and preventDefault) before Astro's ClientRouter
	// click listener, which otherwise starts navigating immediately and cuts
	// the mobile menu's close animation short.
	document.addEventListener('click', (event) => {
		const target = event.target as Element;

		if (target.closest('.mobile-toggle')) {
			setMenuOpen(!document.querySelector('.mobile-menu')?.classList.contains('active'));
			return;
		}

		if (target.closest('.mobile-menu-overlay')) {
			setMenuOpen(false);
			return;
		}

		const link = target.closest<HTMLAnchorElement>('.nav-link, .mobile-menu-link');

		if (!link) return;

		// Re-clicking the tab of the section you are already in closes the panel
		// (navigates home) instead of re-navigating to the same page, which would
		// replay the slide/fade animation on identical content.
		const samePath = stripSlash(new URL(link.href).pathname) === stripSlash(window.location.pathname);
		const destination = samePath ? homeUrl : link.href;

		// From the mobile menu, navigating immediately would let the page swap
		// cut the menu's slide-up short — close it first, navigate when the
		// transition ends (timeout fallback in case it never fires).
		if (link.classList.contains('mobile-menu-link')) {
			event.preventDefault();
			setMenuOpen(false);

			const menu = document.querySelector<HTMLElement>('.mobile-menu');
			let navigated = false;
			const go = () => {
				if (navigated) return;
				navigated = true;
				menu?.removeEventListener('transitionend', onEnd);
				navigate(destination);
			};
			// transitionend bubbles up from the menu links' own transitions, so
			// only accept the menu's own collapse (grid-template-rows) finishing.
			const onEnd = (event: TransitionEvent) => {
				if (event.target === menu && event.propertyName === 'grid-template-rows') go();
			};

			menu?.addEventListener('transitionend', onEnd);
			setTimeout(go, 500);
			return;
		}

		if (samePath) {
			event.preventDefault();
			navigate(homeUrl);
		}
	}, true);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && document.querySelector('.mobile-menu')?.classList.contains('active')) {
			setMenuOpen(false);
		}
	});

	window.addEventListener('resize', () => {
		if (window.innerWidth > 1000 && document.querySelector('.mobile-menu')?.classList.contains('active')) {
			setMenuOpen(false);
		}
	});

	// The nav DOM persists across navigations (transition:persist), so the
	// server-rendered .active state goes stale after the first page. Re-derive
	// the active link from the URL on every navigation, for both the desktop
	// links and the mobile menu links, and tint the navbar underline to match.
	function updateNav() {
		const navbar = document.querySelector<HTMLElement>('.navbar');

		if (!navbar) return;

		let accent: string | undefined;

		document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-menu-link').forEach((link) => {
			const href = link.getAttribute('href') ?? '';
			const isActive =
				href !== '' &&
				stripSlash(href) !== stripSlash(homeUrl) &&
				window.location.pathname.startsWith(stripSlash(href));

			link.classList.toggle('active', isActive);

			if (isActive) {
				link.setAttribute('aria-current', 'page');
				accent = link.dataset.accent;
			} else {
				link.removeAttribute('aria-current');
			}
		});

		if (accent) navbar.style.setProperty('--active-color', accent);
		else navbar.style.removeProperty('--active-color');
	}

	document.addEventListener('astro:page-load', updateNav);
</script>