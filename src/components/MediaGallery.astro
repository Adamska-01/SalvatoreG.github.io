---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	projectTitle: string;
	images: ImageMetadata[];
	videos: { title: string; youtubeId: string }[];
}

const { projectTitle, images, videos } = Astro.props;
const mediaCount = videos.length + images.length;
---

{
	mediaCount > 0 && (
		<div class="media-gallery">
			<div class="media-stage">
				<button class="arrow-button prev" data-gallery-prev aria-label="Previous media" />
				<div class="media-viewport">
					{videos.map((video, index) => (
						<div class="media-item" data-index={index} data-active={index === 0 ? 'true' : undefined}>
							<iframe
								class="yt-player"
								title={video.title}
								src={index === 0 ? `https://www.youtube.com/embed/${video.youtubeId}?enablejsapi=1` : undefined}
								data-src={`https://www.youtube.com/embed/${video.youtubeId}?enablejsapi=1`}
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
								loading="lazy"
							/>
						</div>
					))}
					{images.map((image, index) => (
						<div
							class="media-item"
							data-index={videos.length + index}
							data-active={videos.length + index === 0 ? 'true' : undefined}
						>
							<Image
								src={image}
								alt={`${projectTitle} screenshot ${index + 1}`}
								widths={[640, 1280]}
								sizes="(max-width: 768px) 90vw, 65vw"
								loading={videos.length + index === 0 ? 'eager' : 'lazy'}
								data-gallery-zoom
							/>
						</div>
					))}
				</div>
				<button class="arrow-button next" data-gallery-next aria-label="Next media" />
			</div>

			{mediaCount > 1 && (
				<div class="media-thumbs" role="tablist" aria-label="Project media">
					{Array.from({ length: mediaCount }, (_, index) => (
						<button
							class="media-thumb"
							data-gallery-thumb
							data-index={index}
							aria-label={`Show media ${index + 1}`}
							aria-selected={index === 0 ? 'true' : 'false'}
						/>
					))}
				</div>
			)}
		</div>
	)
}

<div class="zoom-overlay" data-gallery-overlay hidden>
	<img alt="Zoomed screenshot" />
	<button class="overlay-close" data-gallery-overlay-close aria-label="Close zoomed image"></button>
</div>

<style>
	.media-stage {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 10px;
	}

	.media-viewport {
		position: relative;
		width: 65%;
		max-width: 700px;
		aspect-ratio: 16 / 9;
		background-color: rgba(0, 0, 0, 0.25);
	}

	.media-item {
		display: none;
		position: absolute;
		inset: 0;
	}

	.media-item[data-active] {
		display: block;
	}

	.media-item img,
	.media-item iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.media-item img {
		object-fit: contain;
		cursor: zoom-in;
	}

	/* Circular thumbnail buttons (legacy media-button) */
	.media-thumbs {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		padding: 10px 0 0;
	}

	.media-thumb {
		border: 1px solid black;
		border-radius: 50%;
		width: 25px;
		height: 25px;
		margin: 0 4px;
		background-color: var(--chip-background-color);
		cursor: pointer;
		transition: transform 0.2s linear, background-color 0.2s;
	}

	.media-thumb:hover {
		background-color: #b3b6bd;
		transform: scale(1.1);
	}

	.media-thumb[aria-selected='true'] {
		background-color: var(--media-highlight-color);
	}

	/* Prev/next arrows (legacy left-button) */
	.arrow-button {
		overflow: hidden;
		position: relative;
		border: none;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: transparent;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.arrow-button:hover {
		background: var(--close-button-border-color);
	}

	.arrow-button::before,
	.arrow-button::after {
		position: absolute;
		top: 22.4%;
		left: 45%;
		width: 0.125em;
		height: 35%;
		border-radius: 0.125em;
		transform: rotate(50deg);
		background: currentcolor;
		content: '';
	}

	.arrow-button::after {
		top: 43.6%;
		transform: rotate(-50deg);
	}

	.arrow-button.next {
		transform: rotate(180deg);
	}

	/* Fullscreen image zoom */
	.zoom-overlay {
		position: fixed;
		inset: 0;
		z-index: 999;
		background-color: rgba(0, 0, 0, 0.7);
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.zoom-overlay[hidden] {
		display: none;
	}

	.zoom-overlay img {
		max-width: 85%;
		max-height: 80dvh;
		border-radius: 1em;
		object-fit: contain;
		animation: fade-in var(--page-fade-time) ease forwards;
	}

	.overlay-close {
		position: absolute;
		top: 40px;
		right: 40px;
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.overlay-close:hover {
		background: var(--close-button-border-color);
	}

	.overlay-close::before,
	.overlay-close::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 2px;
		height: 50%;
		background: currentcolor;
		content: '';
	}

	.overlay-close::before {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.overlay-close::after {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	@media (max-width: 768px) {
		.media-viewport {
			width: 100%;
		}
	}
</style>

<script>
	function stopVideo(iframe: HTMLIFrameElement) {
		iframe.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'stopVideo', args: '' }), '*');
	}

	function setActive(gallery: Element, index: number) {
		const items = gallery.querySelectorAll<HTMLElement>('.media-item');
		const count = items.length;
		const target = ((index % count) + count) % count;

		items.forEach((item) => {
			const isTarget = Number(item.dataset.index) === target;
			const iframe = item.querySelector<HTMLIFrameElement>('iframe');

			if (isTarget && iframe && !iframe.src) {
				iframe.src = iframe.dataset.src ?? '';
			}

			if (!isTarget && iframe?.src) {
				stopVideo(iframe);
			}

			item.toggleAttribute('data-active', isTarget);
		});

		gallery.querySelectorAll<HTMLElement>('[data-gallery-thumb]').forEach((thumb) => {
			thumb.setAttribute('aria-selected', Number(thumb.dataset.index) === target ? 'true' : 'false');
		});
	}

	function currentIndex(gallery: Element): number {
		return Number(gallery.querySelector<HTMLElement>('.media-item[data-active]')?.dataset.index ?? 0);
	}

	// Delegated events survive view-transition DOM swaps
	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const gallery = target.closest('.media-gallery');

		if (gallery) {
			const thumb = target.closest<HTMLElement>('[data-gallery-thumb]');
			if (thumb) return setActive(gallery, Number(thumb.dataset.index));

			if (target.closest('[data-gallery-prev]')) return setActive(gallery, currentIndex(gallery) - 1);
			if (target.closest('[data-gallery-next]')) return setActive(gallery, currentIndex(gallery) + 1);

			const zoomable = target.closest<HTMLImageElement>('[data-gallery-zoom]');
			if (zoomable) {
				const overlay = document.querySelector<HTMLElement>('[data-gallery-overlay]');
				const overlayImg = overlay?.querySelector('img');

				if (overlay && overlayImg) {
					overlayImg.src = zoomable.currentSrc || zoomable.src;
					overlay.hidden = false;
				}
			}

			return;
		}

		const overlay = target.closest<HTMLElement>('[data-gallery-overlay]');
		if (overlay && (target.closest('[data-gallery-overlay-close]') || target === overlay)) {
			overlay.hidden = true;
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			document.querySelectorAll<HTMLElement>('[data-gallery-overlay]').forEach((overlay) => (overlay.hidden = true));
		}
	});
</script>