---
import { render, type CollectionEntry } from 'astro:content';
import ContentPanel from './ContentPanel.astro';
import MediaGallery from './MediaGallery.astro';
import TechIcons from './TechIcons.astro';
import { sections } from '../scripts/sections';


interface Props {
	entry: CollectionEntry<'personalProjects'> | CollectionEntry<'workProjects'>;
	backHref: string;
	/** Shared with the section's list page so list ↔ detail slides */
	sectionName: string;
}

const { entry, backHref, sectionName } = Astro.props;
const { title, images, videos, technologies, links } = entry.data;
const accent = sections.find((section) => section.id === sectionName)?.accent ?? 'var(--accent-green)';

const { Content } = await render(entry);
---

<ContentPanel backHref={backHref} sectionName={sectionName}>
	<article style={`--card-accent: ${accent};`}>
		<h1 class="project-title header-font accent-title">{title}</h1>

		<MediaGallery projectTitle={title} images={images} videos={videos} />

		<div class="prose">
			<Content />
		</div>

		<h2 class="section-title header-font accent-title">Technologies</h2>
		<TechIcons technologies={technologies} />

		<h2 class="section-title header-font accent-title">Links</h2>
		<div class="project-links">
			{links.length === 0 && <span class="no-links">No links are available.</span>}
			{
				links.map((link) => (
					<a class="link-button" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.text}
					</a>
				))
			}
		</div>
	</article>
</ContentPanel>

<style>
	.project-title,
	.section-title {
		font-size: var(--text-big);
		margin: 12px auto 15px;
		font-weight: 700;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
	}

	.no-links {
		font-size: var(--text-medium);
	}

	.link-button {
		display: flex;
		justify-content: center;
		align-items: center;
		border-radius: 999px;
		background-color: var(--card-background-color);
		border: 1px solid rgba(255, 255, 255, 0.1);
		width: fit-content;
		padding: 10px 20px;
		font-size: var(--text-medium);
		text-decoration: none;
		cursor: pointer;
		color: var(--text-color);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.link-button:hover {
		background-color: color-mix(in srgb, var(--card-accent, var(--accent-green)) 20%, var(--card-background-color));
		border-color: color-mix(in srgb, var(--card-accent, var(--accent-green)) 45%, rgba(255, 255, 255, 0.1));
	}
</style>