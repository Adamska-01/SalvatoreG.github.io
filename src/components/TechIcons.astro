---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	technologies: string[];
}

const { technologies } = Astro.props;

const symbols = import.meta.glob<{ default: ImageMetadata }>('../assets/symbols/*.png', { eager: true });

const displayNames: Record<string, string> = {
	C_Sharp: 'C#',
	ThreeJS: 'Three.js',
	SDL: 'SDL2',
};

const icons = technologies.map((tech) => {
	const module = symbols[`../assets/symbols/${tech}.png`];
	if (!module) throw new Error(`Unknown technology symbol: ${tech}`);

	return { name: displayNames[tech] ?? tech, image: module.default };
});
---

<ul class="tech-icons">
	{
		icons.map(({ name, image }) => (
			<li>
				<Image src={image} alt={name} title={name} width={50} densities={[1, 2]} />
			</li>
		))
	}
</ul>

<style>
	.tech-icons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px 20px;
		list-style: none;
		margin: 0;
		padding: 8px 0;
	}

	.tech-icons img {
		width: 50px;
		height: auto;
		display: block;
	}
</style>