---
/**
 * Fullscreen Three.js background scene.
 * Persisted across page navigations via transition:persist on the wrapper.
 */
---

<div id="scene-root" transition:persist="scene-root">
	<canvas id="scene-canvas" aria-hidden="true"></canvas>
	<div id="scene-loader" role="status" aria-label="Loading 3D scene">
		<div id="scene-loader-label">loading scene <span id="scene-loader-percentage">0%</span></div>
		<div id="scene-loader-track">
			<div id="scene-loader-bar"></div>
		</div>
	</div>
</div>

<style>
	#scene-root,
	#scene-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	#scene-canvas {
		background-color: black;
	}

	/*
	 * Minimal in-scene loader: sits over the (black) canvas, under all UI.
	 * Never blocks interaction — the page is usable while the model loads.
	 */
	#scene-loader {
		position: fixed;
		top: 55%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	#scene-loader.done {
		opacity: 0;
	}

	#scene-loader-label {
		font-family: monospace;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		color: rgba(255, 255, 255, 0.55);
	}

	#scene-loader.error #scene-loader-label {
		color: #ff6b6b;
	}

	#scene-loader-percentage {
		color: var(--accent-green);
	}

	#scene-loader-track {
		width: min(200px, 50vw);
		height: 3px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.12);
		overflow: hidden;
	}

	#scene-loader-bar {
		width: 0;
		height: 100%;
		border-radius: inherit;
		background: var(--accent-green);
		transition: width 0.4s ease;
	}

	#scene-loader.error #scene-loader-bar {
		background: #ff6b6b;
	}
</style>

<script>
	import { initScene } from '../scripts/three/sceneIndex';

	initScene();
</script>