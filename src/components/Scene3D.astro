---
/**
 * Fullscreen Three.js background scene.
 * Persisted across page navigations via transition:persist on the wrapper.
 */
---

<div id="scene-root" transition:persist="scene-root">
	<div id="progress-container">
		<div id="barcontainer">
			<div id="progress-title">Loading</div>
			<div id="progress-percentage-container">Progress: <span id="progress-percentage"></span></div>
			<div id="progress-graph">
				<div id="progress-bar"></div>
			</div>
			<div class="progress-info-container"><span id="progress-info"></span></div>
		</div>
	</div>
	<canvas id="scene-canvas" aria-hidden="true"></canvas>
</div>

<style>
	#scene-root,
	#scene-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	#scene-canvas {
		background-color: black;
	}

	/* Loading progress overlay */
	#progress-container {
		z-index: 9999;
		position: fixed;
		inset: 0;
		font-family: monospace;
		font-size: 2vh;
		color: var(--dark, #000);
		overflow: hidden;
		background: var(--bright, #fff);
	}

	#barcontainer {
		position: absolute;
		top: 18vh;
		left: 0;
		right: 0;
		height: 75vh;
		overflow: hidden;
	}

	#progress-title {
		font-size: 7vh;
		margin-left: 10vw;
		margin-bottom: 7vh;
		font-weight: 700;
	}

	#progress-title::after {
		content: '...';
		animation: dots 1s infinite;
	}

	@keyframes dots {
		25% { content: ''; }
		50% { content: '.'; }
		75% { content: '..'; }
		100% { content: '...'; }
	}

	#progress-percentage-container,
	#progress-info {
		margin-left: 10vw;
		margin-bottom: 1vh;
	}

	#progress-graph {
		height: 3vh;
		width: 80vw;
		border: 1px solid var(--dark, #000);
		overflow: hidden;
		margin-bottom: 5vh;
		margin-left: 10vw;
	}

	#progress-bar {
		height: 3vh;
		width: 0;
		background: var(--dark, #000);
		transition: width 0.5s;
	}

	.progress-info-container {
		margin-left: 10vw;
		margin-right: 10vw;
	}
</style>

<script>
	import { initScene } from '../scripts/three/sceneIndex';

	initScene();
</script>