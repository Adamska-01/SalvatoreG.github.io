---
import { withBase } from '../scripts/paths';

interface Props {
	/** Optional href for a back arrow (e.g. project detail → project list) */
	backHref?: string;
}

const { backHref } = Astro.props;
---

<div class="panel-wrapper">
	<section class="content-panel">
		<div class="panel-controls">
			{
				backHref && (
					<a class="back-button" href={backHref} aria-label="Back">
						<span class="arrow-icon" aria-hidden="true" />
					</a>
				)
			}
			<a class="close-button" href={withBase('/')} aria-label="Close"></a>
		</div>
		<div class="content-separator"></div>
		<div class="panel-content">
			<slot />
		</div>
	</section>
</div>

<style>
	.panel-wrapper {
		display: flex;
		justify-content: center;
		position: relative;
		z-index: 1;
	}

	.content-panel {
		display: flex;
		flex-direction: column;
		width: min(90vw, 90vh);
		max-height: calc(100dvh - 19dvh);
		border-radius: 10px;
		background-color: var(--panel-background-color);
		overflow: hidden;
		animation: fade-in var(--page-fade-time) ease forwards;
	}

	.panel-controls {
		display: flex;
		flex-direction: row-reverse;
		justify-content: space-between;
		padding: 2px;
	}

	.content-separator {
		width: 100%;
		height: 1px;
		background-color: rgb(184, 186, 190);
		flex-shrink: 0;
	}

	.panel-content {
		overflow-y: auto;
		padding: 0 10px 10px;
	}

	/* Close (X) button — ported from legacy buttons.css */
	.close-button {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.close-button:hover {
		background: var(--close-button-border-color);
	}

	.close-button::before,
	.close-button::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 2px;
		height: 50%;
		background: currentcolor;
		content: '';
	}

	.close-button::before {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.close-button::after {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	/* Back (<) button */
	.back-button {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.back-button:hover {
		background: var(--close-button-border-color);
	}

	.back-button .arrow-icon::before,
	.back-button .arrow-icon::after {
		position: absolute;
		top: 22.4%;
		left: 45%;
		width: 0.125em;
		height: 35%;
		border-radius: 0.125em;
		transform: rotate(50deg);
		background: currentcolor;
		content: '';
	}

	.back-button .arrow-icon::after {
		top: 43.6%;
		transform: rotate(-50deg);
	}

	@media (max-width: 768px) {
		.content-panel {
			width: 96vw;
		}
	}
</style>fd