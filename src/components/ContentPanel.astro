---
import { withBase } from '../scripts/paths';

interface Props {
	/** Optional href for a back arrow (e.g. project detail → project list) */
	backHref?: string;
	/**
	 * Set on pages of a section whose list ↔ detail navigation should slide.
	 * Pages sharing the same sectionName keep the panel frame static and
	 * horizontally slide only the content inside it (legacy behavior).
	 * Pages without it (about/contact/404) fade as a whole on navigation.
	 */
	sectionName?: string;
}

const { backHref, sectionName } = Astro.props;
const contentName = sectionName ? `${sectionName}-content` : undefined;
---

<div class="panel-wrapper">
	<a class="panel-backdrop" href={withBase('/')} aria-hidden="true" tabindex="-1"></a>
	{/* All panels share one frame name: within a section (list ↔ detail) the
	    frame stays static while the content slides; across sections the paired
	    frames enable the sequential fade below (data-panel-switch). */}
	<section class="content-panel" transition:name="panel-frame">
		<div class="panel-controls">
			{
				backHref && (
					<a class="back-button" href={backHref} aria-label="Back">
						<span class="arrow-icon" aria-hidden="true" />
					</a>
				)
			}
			<a class="close-button" href={withBase('/')} aria-label="Close" />
		</div>
		<div class="content-separator" />
		{
			contentName ? (
				<div class="panel-content" data-panel-content={contentName} transition:name={contentName}>
					<slot />
				</div>
			) : (
				<div class="panel-content">
					<slot />
				</div>
			)
		}
	</section>
</div>

<style>
	.panel-wrapper {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		position: relative;
		height: 100%;
		padding-bottom: 10px;
	}

	/* Invisible click-catcher: clicking outside the panel closes it. */
	.panel-backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		cursor: default;
	}

	.content-panel {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: min(90vw, 90vh);
		max-height: 100%;
		border-radius: 10px;
		background-color: var(--panel-background-color);
		overflow: hidden;
		/* open/close/tab-switch fades are handled by view transitions. */
	}

	.panel-controls {
		display: flex;
		align-items: center;
		padding: 2px;
	}

	.panel-controls .close-button {
		margin-left: auto;
	}

	.content-separator {
		width: 100%;
		height: 1px;
		background-color: rgb(184, 186, 190);
		flex-shrink: 0;
	}

	.panel-content {
		overflow-y: auto;
		min-height: 0;
		padding: 0 10px 10px;
	}

	/* Close (X) button — ported from legacy buttons.css */
	.close-button {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.close-button:hover {
		background: var(--close-button-border-color);
	}

	.close-button::before,
	.close-button::after {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 2px;
		height: 50%;
		background: currentcolor;
		content: '';
	}

	.close-button::before {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.close-button::after {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	/* Back (<) button */
	.back-button {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		color: var(--close-button-X-color);
		cursor: pointer;
		transition: background var(--transition-time);
	}

	.back-button:hover {
		background: var(--close-button-border-color);
	}

	.back-button .arrow-icon::before,
	.back-button .arrow-icon::after {
		position: absolute;
		top: 22.4%;
		left: 45%;
		width: 0.125em;
		height: 35%;
		border-radius: 0.125em;
		transform: rotate(50deg);
		background: currentcolor;
		content: '';
	}

	.back-button .arrow-icon::after {
		top: 43.6%;
		transform: rotate(-50deg);
	}

	@media (max-width: 768px) {
		.content-panel {
			width: 96vw;
		}
	}
</style>

<style is:global>
	/*
	 * Legacy-style horizontal slide for list ↔ detail navigation, applied only
	 * when both the outgoing and incoming page share the same panel content
	 * (html[data-section-nav], set by the before-swap handler below). All other
	 * navigations fall back to the default view-transition crossfade.
	 */
	html[data-section-nav]::view-transition-image-pair(projects-content),
	html[data-section-nav]::view-transition-image-pair(work-content) {
		overflow: clip;
	}

	html[data-section-nav]::view-transition-old(projects-content),
	html[data-section-nav]::view-transition-old(work-content) {
		animation: vt-slide-out-left var(--transition-time) ease both;
	}

	html[data-section-nav]::view-transition-new(projects-content),
	html[data-section-nav]::view-transition-new(work-content) {
		animation: vt-slide-in-right var(--transition-time) ease both;
	}

	/* History back: reverse direction (detail → list slides right) */
	html[data-section-nav][data-astro-transition='back']::view-transition-old(projects-content),
	html[data-section-nav][data-astro-transition='back']::view-transition-old(work-content) {
		animation-name: vt-slide-out-right;
	}

	html[data-section-nav][data-astro-transition='back']::view-transition-new(projects-content),
	html[data-section-nav][data-astro-transition='back']::view-transition-new(work-content) {
		animation-name: vt-slide-in-left;
	}

	/*
	 * Section → section switch (html[data-panel-switch], set below when both
	 * pages have a panel but their content isn't paired): the old panel fades
	 * out completely, then the new one fades in — sequential, not a crossfade.
	 * Reuses the fade-in/fade-out keyframes from global.css.
	 */
	html[data-panel-switch]::view-transition-group(panel-frame) {
		animation-duration: calc(2 * var(--page-fade-time));
	}

	html[data-panel-switch]::view-transition-old(panel-frame) {
		animation: fade-out var(--page-fade-time) ease both;
	}

	html[data-panel-switch]::view-transition-new(panel-frame) {
		animation: fade-in var(--page-fade-time) ease both;
		animation-delay: var(--page-fade-time);
	}

	/* The inner content is its own view-transition group — sync it with the
	   frame's sequential fade or it would pop in before the panel is there. */
	html[data-panel-switch]::view-transition-old(projects-content),
	html[data-panel-switch]::view-transition-old(work-content) {
		animation: fade-out var(--page-fade-time) ease both;
	}

	html[data-panel-switch]::view-transition-new(projects-content),
	html[data-panel-switch]::view-transition-new(work-content) {
		animation: fade-in var(--page-fade-time) ease both;
		animation-delay: var(--page-fade-time);
	}

	@keyframes vt-slide-out-left {
		to { transform: translateX(-100%); }
	}

	@keyframes vt-slide-in-right {
		from { transform: translateX(100%); }
	}

	@keyframes vt-slide-out-right {
		to { transform: translateX(100%); }
	}

	@keyframes vt-slide-in-left {
		from { transform: translateX(-100%); }
	}
</style>

<script>
	// Back arrow: use real history navigation when possible so the slide
	// animation plays in reverse.
	document.addEventListener('click', (event) => {
		const back = (event.target as HTMLElement).closest('.back-button');

		if (back && window.history.state?.index > 0) {
			event.preventDefault();
			window.history.back();
		}
	});

	// Navigating from a detail page up to its section list.
	document.addEventListener('astro:before-preparation', (event) => {
		const prep = event as any;
		const from = (prep.from.pathname as string).replace(/\/$/, '');
		const to = (prep.to.pathname as string).replace(/\/$/, '');

		if (prep.direction === 'forward' && from.startsWith(to + '/')) {
			prep.direction = 'back';
		}
	});

	// Slide only when old AND new page share the same panel content.
	document.addEventListener('astro:before-swap', (event) => {
		const marker = document.querySelector<HTMLElement>('[data-panel-content]')?.dataset.panelContent;
		const swapEvent = event as any;
		const paired = !!marker && !!swapEvent.newDocument.querySelector(`[data-panel-content="${marker}"]`);
		const panelSwitch =
			!paired &&
			!!document.querySelector('.content-panel') &&
			!!swapEvent.newDocument.querySelector('.content-panel');

		const originalSwap = swapEvent.swap;
		swapEvent.swap = () => {
			originalSwap();
			document.documentElement.toggleAttribute('data-section-nav', paired);
			document.documentElement.toggleAttribute('data-panel-switch', panelSwitch);
		};
	});
</script>