---
import type { CollectionEntry } from 'astro:content';
import ContentPanel from './ContentPanel.astro';
import ProjectCard from './ProjectCard.astro';
import { withBase } from '../scripts/paths';
import { sections } from '../scripts/sections';


interface Props {
	entries: CollectionEntry<'personalProjects'>[] | CollectionEntry<'workProjects'>[];
	/** Site-relative base path for detail links, e.g. "/projects" */
	basePath: string;
	/** Shared with the section's detail pages so list ↔ detail slides */
	sectionName: string;
}

const { entries, basePath, sectionName } = Astro.props;

const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(sorted.map((entry) => entry.data.group))];
const accent = sections.find((section) => section.id === sectionName)?.accent ?? 'var(--accent-green)';
---

<ContentPanel sectionName={sectionName}>
	{
		groups.map((group) => (
			<section class="project-group">
				<h2 class="group-title header-font accent-title">{group}</h2>
				<div class="card-grid">
					{sorted
						.filter((entry) => entry.data.group === group)
						.map((entry) => (
							<ProjectCard
								href={withBase(`${basePath}/${entry.id}/`)}
								title={entry.data.title}
								dateRange={entry.data.dateRange}
								summary={entry.data.summary}
								preview={entry.data.preview}
								accent={accent}
							/>
						))}
				</div>
			</section>
		))
	}
</ContentPanel>

<style>
	.project-group {
		margin: 4px 0 28px;
	}

	.group-title {
		font-size: var(--text-big);
		margin: 0 auto 18px;
	}

	.card-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-content: center;
		gap: 16px;
	}
</style>