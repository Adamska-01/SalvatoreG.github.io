---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPanel from '../components/ContentPanel.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content file: src/content/pages/about.md');

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<ContentPanel>
		<div class="about prose">
			<Content />
		</div>
	</ContentPanel>
</BaseLayout>

<!-- Base typography/layout comes from the shared .prose class (prose.css);
     only about-specific styling lives here. -->
<style>
	/* Lead paragraph: slightly larger and brighter to open the page */
	.about > :global(p:first-child) {
		font-size: 1.12em;
		color: var(--text-color);
	}

	/* ==================== EDUCATION LOGOS ==================== */
	/* Markdown renders each logo as p > a > img: center the link block and
	   let the plain image selectors do the rest (no extra wrappers needed). */
	.about :global(a:has(> img)) {
		display: block;
		width: fit-content;
		margin: 1.4em auto 0.6em;
		text-decoration: none;
	}

	.about :global(img) {
		width: 96px;
		height: auto;
		display: block;
		transition: transform 0.25s ease, filter 0.25s ease;
	}

	.about :global(img[alt*='Righi']) {
		border-radius: 50%;
	}

	.about :global(a:hover > img) {
		transform: scale(1.05);
		filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.45));
	}

	/* Date line directly under a logo: small, muted, centered */
	.about :global(p:has(> a > img) + p) {
		text-align: center;
		font-size: 0.85em;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--text-color) 55%, transparent);
		margin-bottom: 1.6em;
	}

	/* Technologies & Tools (the page's final list) rendered as chips */
	.about :global(ul:last-of-type) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		list-style: none;
		margin: 1.2em 0 0;
		padding: 0;
	}

	.about :global(ul:last-of-type li) {
		margin: 0;
		padding: 0.4em 1em;
		font-size: 0.92em;
		background: var(--card-background-color);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.about :global(ul:last-of-type li:hover) {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent-green) 45%, transparent);
	}
</style>
