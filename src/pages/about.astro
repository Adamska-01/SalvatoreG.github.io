---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPanel from '../components/ContentPanel.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content file: src/content/pages/about.md');

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<ContentPanel>
		<div class="about markdown">
			<Content />
		</div>
	</ContentPanel>
</BaseLayout>

<style>
	.about {
		font-size: var(--text-medium);
		text-align: justify;
		text-align-last: left;
		padding: 7px;
	}

	/* Green accent for **bold** text, same convention as project pages */
	.about :global(strong) {
		color: var(--accent-green);
		font-weight: 600;
	}

	.about :global(a) {
		color: var(--link-color);
		text-decoration: underline;
		transition: color 0.2s ease;
	}

	.about :global(a:hover) {
		color: var(--link-hover-color);
	}

	.about :global(li) {
		margin-bottom: 3px;
	}

	/* ## headings render like the legacy section titles */
	.about :global(h2) {
		font-family: var(--font-header);
		font-optical-sizing: auto;
		font-weight: 700;
		font-size: var(--text-big);
		text-align: center;
		margin: 25px auto 12px;
		padding-bottom: 5px;
		border-bottom: 2px solid white;
		width: 90%;
	}

	/* ### headings = green sub-sections */
	.about :global(h3) {
		color: var(--accent-green);
		font-size: var(--text-medium);
		font-weight: 600;
		margin: 14px 0 4px;
	}

	/* Education logos: centered images with hover grow; links around them lose underline */
	.about :global(p:has(> a > img)) {
		text-align: center;
		text-align-last: center;
	}

	.about :global(a:has(> img)) {
		display: inline-block;
		text-decoration: none;
	}

	.about :global(img) {
		width: 90px;
		height: auto;
		transition: transform 0.2s linear;
	}

	.about :global(img[alt*='Righi']) {
		border-radius: 50%;
	}

	.about :global(a:hover > img) {
		transform: scale(1.04);
	}

	/* Center the education date lines (paragraph right after a logo paragraph) */
	.about :global(p:has(> a > img) + p) {
		text-align: center;
		text-align-last: center;
	}

	/* Center the plain list under Technologies & Tools */
	.about :global(h2:last-of-type ~ ul) {
		width: fit-content;
		margin: 0 auto 15px;
	}
</style>
