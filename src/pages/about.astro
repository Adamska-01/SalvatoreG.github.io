---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPanel from '../components/ContentPanel.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content file: src/content/pages/about.md');

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<ContentPanel>
		<div class="about prose">
			<Content />
		</div>
	</ContentPanel>
</BaseLayout>

<!-- Base typography/layout comes from the shared .prose class (prose.css);
     only about-specific styling lives here. -->
<style>
	/* Lead paragraph: slightly larger and brighter to open the page */
	.about > :global(p:first-child) {
		font-size: 1.12em;
		color: var(--text-color);
	}

	/* ==================== EDUCATION CARDS ==================== */
	.about :global(a:has(> img)) {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5px;
		width: 40%;
		margin: 1.2em auto;
		padding: 16px 14px;
		background: var(--card-background-color);
		border: 1px solid var(--card-border-color);
		border-radius: 12px;
		text-decoration: none;
		text-align: center;
		font-size: 0.8em;
		line-height: 1.4;
		color: color-mix(in srgb, var(--text-color) 65%, transparent);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.about :global(a:has(> img):hover) {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent-green) 40%, var(--card-border-color));
	}

	.about :global(a:has(> img) img) {
		width: 66px;
		height: auto;
		display: block;
		transition: transform 0.25s ease, filter 0.25s ease;
	}

	.about :global(a:has(> img) img[alt*='Righi']) {
		border-radius: 50%;
	}

	.about :global(a:has(> img):hover img) {
		transform: scale(1.05);
		filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.45));
	}

	.about :global(a:has(> img) strong) {
		font-size: 1.15em;
		font-weight: 600;
		color: var(--text-color);
	}

	/* Technologies & Tools (the page's final list) rendered as chips */
	.about :global(ul:last-of-type) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		list-style: none;
		margin: 1.2em 0 0;
		padding: 0;
	}

	.about :global(ul:last-of-type li) {
		margin: 0;
		padding: 0.4em 1em;
		font-size: 0.92em;
		background: var(--card-background-color);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.about :global(ul:last-of-type li:hover) {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent-green) 45%, transparent);
	}
</style>
